# Окружение
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Данные и модели — в DVC, не в Git.
# Сами файлы churn.csv и model.joblib скрывает DVC (data/raw/.gitignore,
# models/.gitignore), здесь только то, что DVC не отслеживает.
/data/processed/
/models/model_meta.json

# Метрики и отчёты — маленькие, их держим в Git:
# так работают `dvc metrics diff` и сравнение между коммитами
/reports/*
!/reports/.gitkeep
!/reports/*.json
!/reports/*.md

# HTML с графиками от `dvc plots show`, пересоздаётся из reports/roc.json
/dvc_plots/

# MLflow локальный бэкенд
mlruns/
mlartifacts/
mlflow.db

# Секреты
.env
*.pem
*.key

# IDE / ОС
.idea/
.vscode/
.DS_Store
